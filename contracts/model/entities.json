      "day_calls": {"type": "integer", "minimum": 0},
      "client_calls": {"type": "integer", "minimum": 0, "optional": true, "description": "Ask only: the calls one client may make a day"},
      "note": {"type": "string", "optional": true}
    }
  },
  {
    "id": "Change",
    "label": {"en": "Change", "fr": "Modification"},
    "prefix": "chg",
