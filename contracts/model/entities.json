        "label": {"en": "Valid until", "fr": "Valable jusqu'au"}
      },
      "source_refs": {
        "type": "array",
        "items": "EntityId",
        "refs": ["Source"],
        "min_items": 1,
        "label": {"en": "Sources", "fr": "Sources"}
      }
    }
  },
  {
    "id": "AltName",
    "label": {"en": "Alias", "fr": "Alias"},
