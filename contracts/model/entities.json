      "language": {"type": "string", "description": "Language code (contracts/languages.json)"},
      "targets": {"type": "array", "items": "EntityId", "refs": ["Product"], "min_items": 1},
      "category": {"type": "TermId", "optional": true, "description": "A category whose products also count as a hit"},
      "note": {"type": "string", "optional": true}
    }
