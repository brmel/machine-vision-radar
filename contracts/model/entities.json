    "id": "EvalQuery",
    "label": {"en": "Evaluation query", "fr": "Requête d'évaluation"},
    "prefix": "evq",
    "collection": "eval_queries",
    "description": "A curated search query and the products a good answer lists in its first five: `radar eval run search` scores search on them, `eval run ask` the answers that cite them, and `eval run draft` the drafts about them.",
    "internal": true,
    "fields": {
      "id": {"type": "EntityId"},
      "version": {"type": "integer", "minimum": 1, "description": "Per-entity version counter: 1 when created, +1 on every Change"},
