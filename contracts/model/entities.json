  {
    "id": "FeedItem",
    "label": {"en": "News item", "fr": "Actualité"},
    "prefix": "nws",
    "collection": "feed_items",
    "description": "A news article: a short text whose every sentence cites the catalog, under the brand's byline, in the order the founder publishes. A draft is a proposal in the review queue; the founder's approval publishes it, with `published_at` from the clock.",
    "fields": {
      "id": {"type": "EntityId"},
      "version": {"type": "integer", "minimum": 1, "description": "Per-entity version counter: 1 when created, +1 on every Change"},
      "slug": {"type": "string", "description": "URL key, permanent once published"},
      "kind": {"type": "TermId", "vocabulary": "feed_item_kinds"},
      "authorship": {
        "type": "enum",
        "values": ["human", "template", "ai_draft"],
        "description": "Who wrote it: the founder, a template of feed.json, or a model"
      },
      "byline": {"type": "LocalizedText", "description": "The brand's editorial byline (feed.json), never a personal name"},
      "title": {"type": "LocalizedText"},
      "summary": {"type": "LocalizedText"},
      "body": {"type": "array", "items": "FeedSentence", "min_items": 1},
      "cites": {
        "type": "array",
        "items": "EntityId",
        "refs": ["Product", "Organization", "Source"],
        "min_items": 1,
        "description": "Every id its sentences cite, by which a withdrawal of one finds the article"
      },
      "position": {"type": "integer", "minimum": 1, "description": "Its place in the publishing order"},
      "published_at": {"type": "Instant", "optional": true, "set_on_approval": true, "description": "When the founder published it: review's clock when it approves the draft; a draft has none"},
      "revised_at": {"type": "Instant", "optional": true, "description": "When the founder last revised it once published, from the clock"},
      "event_date": {"type": "PartialDate", "optional": true, "description": "The vendor's date of the event, only with event_source"},
      "event_source": {
        "type": "EntityId",
        "refs": ["Source"],
        "optional": true,
        "description": "The source of event_date"
      }
    }
  },
  {
    "id": "AiCap",
    "label": {"en": "AI cap", "fr": "Plafond d'IA"},
    "prefix": "cap",
    "collection": "ai_caps",
    "description": "The model and spend caps of one AI use, or the caps of all of them together: its `model`, one of the registry's (data/registry/ai.json), and at most `month_cad` of model spend a month and `day_calls` calls a day, and for Ask at most `client_calls` a client a day. The registry holds the defaults; a record replaces them for its use, is read on every call, and changes by changeset with a reason. One per use: its id is keyed on the use (`keyed(\"cap\", use)`). Founder-only.",
    "internal": true,
    "fields": {
