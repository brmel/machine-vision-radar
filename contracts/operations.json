{
  "$comment": "Every domain operation: its CLI command, the shape of its --json output (a JSON Schema), its admin screen and its MCP tool (whose own schemas come from contracts/model/tools.json). A test fails when the CLI and this list differ.",
  "$defs": {
    "ProposalStatus": {"type": "string", "enum": ["suggested", "approved", "rejected", "retracted"]},
    "ResearchStatus": {
      "type": "string",
      "enum": ["running", "done", "partial", "blocked", "cancelled", "capped", "failed"]
    },
    "Proposal": {
      "type": "object",
      "required": ["id", "files_on", "status", "reason", "actor_kind", "author", "created_at", "reports", "sources", "edits"],
      "properties": {"status": {"$ref": "#/$defs/ProposalStatus"}}
    },
    "DecisionOutcome": {
      "type": "object",
      "required": ["done", "refused", "held"],
      "properties": {
        "done": {"type": "array", "items": {"$ref": "#/$defs/Proposal"}},
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["proposal", "findings"],
            "properties": {"proposal": {"$ref": "#/$defs/Proposal"}}
          }
        },
        "held": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["proposal", "waits_on"],
            "properties": {"proposal": {"$ref": "#/$defs/Proposal"}}
          }
        }
      }
    }
  },
  "operations": [
    {
      "id": "product.search",
      "summary": "rank products for a query from the search index",
      "cli": "product search",
      "admin": "/admin/search/console",
      "mcp": "search_products",
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "slug", "name", "vendor", "vendor_name", "category", "score", "why", "rank_sources"]
        }
      }
    },
    {
      "id": "product.compare",
      "summary": "compare products side by side",
      "cli": "product compare",
      "admin": null,
      "mcp": null,
      "output": {"type": "object", "required": ["products", "specs"]}
    },
    {
      "id": "product.get",
      "summary": "read a product as its page shows it, with its spec labels",
      "cli": "product get",
      "admin": null,
      "mcp": "get_product",
      "output": {
        "type": "object",
        "required": ["product", "spec_definitions"],
        "properties": {"product": {"type": "object", "required": ["id", "slug", "name", "core", "detail"]}}
      }
    },
    {
      "id": "source.search",
      "summary": "find the catalog's Sources and media Documents by address, vendor, type and date",
      "cli": "source search",
      "admin": null,
      "mcp": "search_sources",
      "output": {"type": "object", "required": ["sources", "documents"]}
    },
    {
      "id": "source.dedupe",
      "summary": "plan the merge of each address more than one Source holds into the earliest retrieved; with --file, file it as one bundle",
      "cli": "source dedupe",
      "admin": null,
      "mcp": null,
      "output": {
        "type": "object",
        "required": ["groups", "proposals", "bundle", "filed", "refusals"],
        "properties": {
          "groups": {"type": "array", "items": {"type": "object", "required": ["url", "kept", "extras", "repoint"]}},
          "bundle": {"type": ["string", "null"]}
        }
      }
    },
    {
      "id": "org.get",
      "summary": "read an organization with its owners on a date",
      "cli": "org get",
      "admin": null,
      "mcp": null,
      "output": {"type": "object", "required": ["id", "slug", "name", "on", "named", "owners"]}
    },
    {
      "id": "record.list",
      "summary": "list a kind's records whose name or id holds a query, a page at a time, as the admin's Catalog does",
      "cli": "record list",
      "admin": "/admin/products",
      "mcp": null,
      "output": {"type": "object", "required": ["records", "total"]}
    },
    {
      "id": "record.get",
      "summary": "one record of any kind, as the admin's record page edits it",
      "cli": "record get",
      "admin": "/admin/records/<id>",
      "mcp": null,
      "output": {"type": "object", "required": ["record"]}
    },
    {
      "id": "record.history",
      "summary": "list a record's versions, a page at a time; a product's are its History page's when it has one",
      "cli": "record history",
      "admin": "/admin/records/<id>/history",
      "mcp": null,
      "output": {"type": "object", "required": ["versions"]}
    },
    {
      "id": "record.diff",
      "summary": "diff two versions of a record",
      "cli": "record diff",
      "admin": "/admin/records/<id>/history",
      "mcp": null,
      "output": {
        "type": "object",
        "required": ["changes"],
        "properties": {"changes": {"type": "array", "items": {"type": "object", "required": ["path"]}}}
      }
    },
    {
      "id": "record.rollback",
      "summary": "propose rolling a record back to an earlier version, as a new one",
      "cli": "record rollback",
      "admin": "/admin/records/<id>/history",
      "mcp": null,
      "output": {"$ref": "#/$defs/Proposal"}
    },
