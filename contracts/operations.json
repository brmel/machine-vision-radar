        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "products", "missing_required", "specs"],
              "properties": {
                "specs": {"type": "array", "items": {"type": "object", "required": ["key", "products", "share"]}}
              }
            }
          }
