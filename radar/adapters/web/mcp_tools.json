{
  "$comment": "DO NOT EDIT: generated by `python -m radar model generate` from contracts/model/tools.json.",
  "tools": [
    {
      "name": "search_products",
      "title": "Search Products",
      "description": "Rank the catalog's products for a query, as the site's search does: each hit with its score and why it matched. The same as `radar product search`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "The words to look for"},
          "limit": {"type": "integer", "minimum": 1, "description": "The most hits to return", "default": 10},
          "category": {"$ref": "#/$defs/TermId", "description": "Search one category only, by its id"},
          "tag": {"$ref": "#/$defs/TermId", "description": "Keep the products with this tag"},
          "semantic": {"type": "boolean", "description": "Blend keyword ranking with vector similarity", "default": false}
        },
        "required": ["query"],
        "additionalProperties": false,
        "$defs": {
          "TermId": {"description": "Id of a registry item (a Term, Unit, Dimension, SpecDefinition or Category).", "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"}
        }
      },
      "outputSchema": {
        "description": "What a query finds, ranked: the admin's search console and the MCP server's search_products.",
        "type": "object",
        "properties": {"hits": {"type": "array", "items": {"$ref": "#/$defs/SearchHitView"}}},
        "required": ["hits"],
        "additionalProperties": false,
        "$defs": {
          "MatchView": {
            "description": "Why a product matched a query: the query terms found in a field, or in a published value (its spec key and label).",
            "type": "object",
            "properties": {
              "field": {"type": "string"},
              "terms": {"type": "array", "items": {"type": "string"}},
              "key": {"type": "string"},
              "label": {"type": "string"}
            },
            "required": ["field", "terms"],
            "additionalProperties": false
          },
          "SearchHitView": {
            "description": "A product a query found, as `radar product search` prints it: its score, why it matched and its rank in each ranking.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "slug": {"type": "string"},
              "name": {"type": "string"},
              "vendor": {"type": "string"},
              "vendor_name": {"type": "string"},
              "category": {"type": "string"},
              "score": {"type": "number"},
              "why": {"type": "array", "items": {"$ref": "#/$defs/MatchView"}},
              "rank_sources": {"type": "object", "additionalProperties": {"type": "integer"}}
            },
            "required": ["id", "slug", "name", "vendor", "vendor_name", "category", "score", "why", "rank_sources"],
            "additionalProperties": false
          }
        }
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false}
    },
    {
      "name": "get_product",
      "title": "Get Product",
      "description": "One product as its page shows it: its spec rows with the current source of each value, versions, offerings, lifecycle, successors, media and sources, with the label and unit of each spec. The same as `radar product get`.",
      "inputSchema": {
        "type": "object",
        "properties": {"id": {"type": "string", "description": "The product's id or slug"}},
        "required": ["id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "description": "A product as `radar product get` and the MCP server's get_product give it: its page's view, and the label and unit of each spec its rows name.",
        "type": "object",
        "properties": {
          "product": {"$ref": "#/$defs/ProductView"},
          "spec_definitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/SpecLabel"}}
        },
        "required": ["product", "spec_definitions"],
        "additionalProperties": false,
        "$defs": {
          "ComponentLink": {
            "description": "A product another one uses, as a link to its hub.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "slug": {"type": "string"},
              "name": {"type": "string"},
              "hub": {"type": "string", "description": "Its hub's path segment"}
            },
            "required": ["id", "slug", "name", "hub"],
            "additionalProperties": false
          },
          "EventRow": {
            "description": "One lifecycle event on the product's timeline.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "type": {"$ref": "#/$defs/TermRef"},
              "state": {"$ref": "#/$defs/TermRef"},
              "occurred": {"type": "boolean"},
              "date": {"$ref": "#/$defs/PartialDate"},
              "source": {"type": "string"}
            },
            "required": ["id", "type", "state", "occurred", "date"],
            "additionalProperties": false
          },
          "HubRef": {
            "description": "A product's hub: its path segment and how many products use it.",
            "type": "object",
            "properties": {"path": {"type": "string"}, "users": {"type": "integer"}},
            "required": ["path", "users"],
            "additionalProperties": false
          },
          "IdentifierRow": {
            "description": "One identifier of a product: its scheme, its value, and the schema.org property its scheme maps to.",
            "type": "object",
            "properties": {
              "scheme": {"$ref": "#/$defs/TermRef"},
              "value": {"type": "string"},
              "schema_org": {"type": "string"}
            },
            "required": ["scheme", "value"],
            "additionalProperties": false
          },
          "LocalizedText": {
            "description": "BCP-47 language tag to text; en is required and is the fallback.",
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1},
            "required": ["en"]
          },
          "MediaItem": {
            "description": "One Document about the product; `href` is where a page links it (the source URL unless its rights are public).",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "kind": {"$ref": "#/$defs/TermRef"},
              "mime": {"type": "string"},
              "bytes": {"type": "integer"},
              "rights": {"$ref": "#/$defs/TermRef"},
              "title": {"$ref": "#/$defs/LocalizedText"},
              "language": {"type": "string"},
              "href": {"type": "string"},
              "source_url": {"type": "string"},
              "version": {"type": "string"}
            },
            "required": ["id", "kind", "mime", "bytes", "rights"],
            "additionalProperties": false
          },
          "ModelRow": {
            "description": "One model of a family, with its core specs.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "slug": {"type": "string"},
              "name": {"type": "string"},
              "specs": {"type": "array", "items": {"$ref": "#/$defs/SpecCell"}}
            },
            "required": ["id", "slug", "name", "specs"],
            "additionalProperties": false
          },
          "OfferingRow": {
            "description": "One commercial offering, holding the fields its CategoryProfile shows.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "licence_type": {"$ref": "#/$defs/TermRef"},
              "term": {"$ref": "#/$defs/TermRef"},
              "binding": {"$ref": "#/$defs/TermRef"},
              "price": {"$ref": "#/$defs/Price"},
              "valid_from": {"$ref": "#/$defs/PartialDate"},
              "valid_to": {"$ref": "#/$defs/PartialDate"},
              "source": {"type": "string"}
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "OrgBrief": {
            "description": "An organization as a link shows it.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "slug": {"type": "string"},
              "name": {"type": "string"},
              "country": {"type": "string"}
            },
            "required": ["id", "slug", "name"],
            "additionalProperties": false
          },
          "PartialDate": {
            "description": "Calendar date with an explicit precision, so no date claims more exactness than its source.",
            "type": "object",
            "properties": {
              "value": {"type": "string", "description": "YYYY, YYYY-H1|H2, YYYY-Q1..Q4, YYYY-MM or YYYY-MM-DD, matching precision"},
              "precision": {"enum": ["year", "half", "quarter", "month", "day"]},
              "approximate": {"type": "boolean"}
            },
            "required": ["value", "precision"],
            "additionalProperties": false
          },
          "Price": {
            "description": "Price with ISO 4217 currency and the date it was observed.",
            "type": "object",
            "properties": {
              "amount": {"type": "number"},
              "currency": {"type": "string"},
              "as_of": {"$ref": "#/$defs/PartialDate"}
            },
            "required": ["amount", "currency", "as_of"],
            "additionalProperties": false
          },
          "ProductLink": {
            "description": "A product as a link shows it.",
            "type": "object",
            "properties": {"id": {"type": "string"}, "slug": {"type": "string"}, "name": {"type": "string"}},
            "required": ["id", "slug", "name"],
            "additionalProperties": false
          },
          "ProductView": {
            "description": "Everything a product page shows, current sources only.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "slug": {"type": "string"},
              "name": {"type": "string"},
              "kind": {"type": "string"},
              "version": {"type": "integer", "description": "The record's version"},
              "history": {"type": "boolean", "description": "It has a History view: it, or a public record about it, has more than one version"},
              "category": {"type": "string"},
              "summary": {"$ref": "#/$defs/LocalizedText"},
              "website_url": {"type": "string"},
              "vendor": {"$ref": "#/$defs/OrgBrief"},
              "status": {"$ref": "#/$defs/StatusView"},
              "tags": {"type": "array", "items": {"$ref": "#/$defs/TermRef"}},
              "identifiers": {
                "type": "array",
                "items": {"$ref": "#/$defs/IdentifierRow"},
                "description": "Its identifiers, in their schemes' registry order"
              },
              "aliases": {
                "type": "array",
                "items": {"type": "string"},
                "description": "The AltNames and other-than-primary Names of the product and its vendor: search terms only, never shown"
              },
              "thumbnail_url": {"type": "string"},
              "family": {"$ref": "#/$defs/ProductLink"},
              "models": {"type": "array", "items": {"$ref": "#/$defs/ModelRow"}},
              "core": {"type": "array", "items": {"$ref": "#/$defs/SpecCell"}},
              "detail": {"type": "array", "items": {"$ref": "#/$defs/SpecCell"}},
              "versions": {"type": "array", "items": {"$ref": "#/$defs/VersionRow"}},
              "offerings": {"type": "array", "items": {"$ref": "#/$defs/OfferingRow"}},
              "lifecycle": {"type": "array", "items": {"$ref": "#/$defs/EventRow"}},
              "relations": {
                "type": "array",
                "items": {"$ref": "#/$defs/RelationRow"},
                "description": "Its relations to other products, each read from its side, but those its component and hub links show"
              },
              "components": {
                "type": "array",
                "items": {"$ref": "#/$defs/ComponentLink"},
                "description": "The products it uses that have a hub"
              },
              "hub": {"$ref": "#/$defs/HubRef", "description": "Its hub, when products use it"},
              "media": {"type": "array", "items": {"$ref": "#/$defs/MediaItem"}},
              "indexable": {"type": "boolean", "description": "It publishes every spec its CategoryProfile requires at publish; a page that does not is noindex and out of the sitemap"},
              "sources": {"type": "array", "items": {"$ref": "#/$defs/SourceView"}}
            },
            "required": ["id", "slug", "name", "kind", "version", "history", "category", "vendor", "tags", "identifiers", "models", "core", "detail", "versions", "offerings", "lifecycle", "relations", "components", "media", "indexable", "sources"],
            "additionalProperties": false
          },
          "RelationRow": {
            "description": "One relation as a product's page reads it: its type, its side's label, the other product, its basis, and the schema.org property its side maps to.",
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "label": {"$ref": "#/$defs/LocalizedText"},
              "product": {"$ref": "#/$defs/ProductLink"},
              "basis": {"enum": ["asserted", "derived"]},
              "schema_org": {"type": "string"}
            },
            "required": ["type", "label", "product", "basis"],
            "additionalProperties": false
          },
          "SourceView": {
            "description": "A source as a page cites it.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "type": {"$ref": "#/$defs/TermRef"},
              "url": {"type": "string"},
              "title": {"type": "string"},
              "retrieved_at": {"type": "string"}
            },
            "required": ["id", "type", "retrieved_at"],
            "additionalProperties": false
          },
          "SpecCell": {
            "description": "One spec row: its value and current source, or neither when no sourced claim gives it.",
            "type": "object",
            "properties": {
              "key": {"type": "string"},
              "value": {"$ref": "#/$defs/ViewValue"},
              "source": {"type": "string"},
              "group": {"type": "string", "description": "The spec group the row comes from; none for the category's own specs"}
            },
            "required": ["key"],
            "additionalProperties": false
          },
          "SpecLabel": {
            "description": "A spec's registry label, the unit symbol its values are published in, and which way a value is better.",
            "type": "object",
            "properties": {
              "label": {"$ref": "#/$defs/LocalizedText"},
              "unit": {"type": "string"},
              "better": {"enum": ["higher", "lower"]}
            },
            "required": ["label"],
            "additionalProperties": false
          },
          "StatusView": {
            "description": "The derived status and its current source.",
            "type": "object",
            "properties": {"term": {"$ref": "#/$defs/TermRef"}, "source": {"type": "string"}},
            "required": ["term"],
            "additionalProperties": false
          },
          "TermRef": {
            "description": "A registry term as pages show it: its id and label.",
            "type": "object",
            "properties": {"id": {"type": "string"}, "label": {"$ref": "#/$defs/LocalizedText"}},
            "required": ["id", "label"],
            "additionalProperties": false
          },
          "VersionRow": {
            "description": "One product version, holding the fields its CategoryProfile shows.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "channel": {"$ref": "#/$defs/TermRef"},
              "released": {"$ref": "#/$defs/PartialDate"},
              "end_of_support": {"$ref": "#/$defs/PartialDate"},
              "source": {"type": "string"}
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "ViewQuantity": {
            "description": "A number in the spec's one published unit (its symbol).",
            "type": "object",
            "properties": {"value": {"type": "number"}, "unit": {"type": "string"}},
            "required": ["value"],
            "additionalProperties": false
          },
          "ViewRange": {
            "description": "A range in the spec's one published unit (its symbol).",
            "type": "object",
            "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "unit": {"type": "string"}},
            "required": ["min", "max"],
            "additionalProperties": false
          },
          "ViewValue": {
            "description": "A published spec value, tagged by kind.",
            "oneOf": [
              {
                "type": "object",
                "properties": {"quantity": {"$ref": "#/$defs/ViewQuantity"}},
                "required": ["quantity"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"range": {"$ref": "#/$defs/ViewRange"}},
                "required": ["range"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"term": {"$ref": "#/$defs/TermRef"}},
                "required": ["term"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"terms": {"type": "array", "items": {"$ref": "#/$defs/TermRef"}, "minItems": 1}},
                "required": ["terms"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"boolean": {"type": "boolean"}},
                "required": ["boolean"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"string": {"type": "string"}},
                "required": ["string"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "none": {"$ref": "#/$defs/TermRef", "description": "No value, for the reason the term says"}
                },
                "required": ["none"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false}
    },
    {
      "name": "search_sources",
      "title": "Search Sources",
      "description": "The catalog's Sources and media Documents by address, vendor, type and date, newest first, to cite a source the catalog holds rather than propose it again. Every filter given must hold. The same as `radar source search`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "description": "Text the address contains, in any case"},
          "vendor": {"type": "string", "description": "An organization's id or slug: the sources and files on its website"},
          "type": {"$ref": "#/$defs/TermId", "description": "A source type, or a document kind"},
          "since": {"type": "string", "format": "date", "description": "Retrieved on or after this day, YYYY-MM-DD"},
          "until": {"type": "string", "format": "date", "description": "Retrieved on or before this day, YYYY-MM-DD"},
          "limit": {"type": "integer", "minimum": 1, "description": "The most sources, and the most documents, to return", "default": 25}
        },
        "required": [],
        "additionalProperties": false,
        "$defs": {
          "TermId": {"description": "Id of a registry item (a Term, Unit, Dimension, SpecDefinition or Category).", "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"}
        }
      },
      "outputSchema": {
        "description": "The catalog's Sources and media Documents a `radar source search` finds, each list newest first.",
        "type": "object",
        "properties": {
          "sources": {"type": "array", "items": {"$ref": "#/$defs/SourceView"}},
          "documents": {"type": "array", "items": {"$ref": "#/$defs/DocumentView"}}
        },
        "required": ["sources", "documents"],
        "additionalProperties": false,
        "$defs": {
          "DocumentView": {
            "description": "A media Document as `radar source search` finds it: the digest and the address that dedupe its file, and the records it is about.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "kind": {"$ref": "#/$defs/TermRef"},
              "title": {"$ref": "#/$defs/LocalizedText"},
              "mime": {"type": "string"},
              "bytes": {"type": "integer"},
              "sha256": {"type": "string"},
              "rights": {"$ref": "#/$defs/TermRef"},
              "source_url": {"type": "string"},
              "fetched_at": {"type": "string"},
              "subjects": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["id", "kind", "mime", "bytes", "sha256", "rights", "fetched_at", "subjects"],
            "additionalProperties": false
          },
          "LocalizedText": {
            "description": "BCP-47 language tag to text; en is required and is the fallback.",
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1},
            "required": ["en"]
          },
          "SourceView": {
            "description": "A source as a page cites it.",
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "type": {"$ref": "#/$defs/TermRef"},
              "url": {"type": "string"},
              "title": {"type": "string"},
              "retrieved_at": {"type": "string"}
            },
            "required": ["id", "type", "retrieved_at"],
            "additionalProperties": false
          },
          "TermRef": {
            "description": "A registry term as pages show it: its id and label.",
            "type": "object",
            "properties": {"id": {"type": "string"}, "label": {"$ref": "#/$defs/LocalizedText"}},
            "required": ["id", "label"],
            "additionalProperties": false
          }
        }
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false}
    },
    {
      "name": "submit_proposal",
      "title": "Submit Proposal",
      "description": "File a proposed change to the catalog for the founder to review: nothing changes until he approves it. Every change cites at least one source (search_sources finds the catalog's). A new product named or numbered as the one held product of its maker merges into it, as its edit; the same proposal filed again counts one more report. The same as `radar proposal submit`, by the agent and with its token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files_on": {"$ref": "#/$defs/FilesOn", "description": "What it does: adds records, changes held ones, makes two records of one thing one, or withdraws one"},
          "reason": {"type": "string", "description": "Why, in a sentence the founder reads"},
          "subject": {"$ref": "#/$defs/EntityId", "description": "The record it is about: the product a new product's records hang on, or the held record it changes"},
          "changeset": {"type": "string", "description": "The changes, as JSON text: {\"changes\": [{\"op\": \"put\", \"entity\": {a record with its id}, \"reason\": \"...\", \"source_refs\": [\"src_...\"]}, {\"op\": \"retract\", \"id\": \"...\", \"reason\": \"...\", \"source_refs\": [...]}]}"}
        },
        "required": ["files_on", "reason", "changeset"],
        "additionalProperties": false,
        "$defs": {
          "EntityId": {"description": "Opaque id: the entity's three-letter prefix (entities.json) plus 10 lowercase Crockford base32 characters.", "type": "string", "pattern": "^[a-z]{3}_[0123456789abcdefghjkmnpqrstvwxyz]{10}$"},
          "FilesOn": {
            "description": "The event that files a proposal: a record added, changed, merged or withdrawn, a reader's report, a quality check, a news draft, a rollback.",
            "enum": ["create", "update", "merge", "retract", "report", "quality", "feed", "rollback"]
          }
        }
      },
      "outputSchema": {
        "description": "A proposal in the review queue. `changes` and `changeset` come with one proposal, not a list; `problem` says why its change no longer applies; `token_id` is the id of the agent token an agent's came with; `bundle` is the research run whose bundle it belongs to.",
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "files_on": {"$ref": "#/$defs/FilesOn"},
          "status": {"$ref": "#/$defs/ProposalStatus"},
          "subject": {"type": "string"},
          "reason": {"type": "string"},
          "message": {"type": "string"},
          "source_url": {"type": "string"},
          "actor_kind": {"$ref": "#/$defs/ActorKind"},
          "author": {"type": "string"},
          "created_at": {"type": "string"},
          "reports": {"type": "integer"},
          "reviewer": {"type": "string"},
          "note": {"type": "string"},
          "decided_at": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}},
          "edits": {"type": "array", "items": {"$ref": "#/$defs/ProposalEdit"}},
          "token_id": {"type": "string"},
          "bundle": {"type": "string"},
          "changes": {"type": "array", "items": {"$ref": "#/$defs/ProposedChange"}},
          "changeset": {"type": "string"},
          "problem": {"type": "string"}
        },
        "required": ["id", "files_on", "status", "reason", "actor_kind", "author", "created_at", "reports", "sources", "edits"],
        "additionalProperties": false,
        "$defs": {
          "ActorKind": {
            "description": "Who made a change or filed a proposal: a person (the founder or a reader), an agent, or an import.",
            "enum": ["human", "agent", "import"]
          },
          "FilesOn": {
            "description": "The event that files a proposal: a record added, changed, merged or withdrawn, a reader's report, a quality check, a news draft, a rollback.",
            "enum": ["create", "update", "merge", "retract", "report", "quality", "feed", "rollback"]
          },
          "ProposalEdit": {
            "description": "One edit of a proposal's change: when, by whom, why.",
            "type": "object",
            "properties": {"at": {"type": "string"}, "actor": {"type": "string"}, "note": {"type": "string"}},
            "required": ["at", "actor", "note"],
            "additionalProperties": false
          },
          "ProposalStatus": {
            "description": "Where a proposal stands in the review queue: waiting, applied, refused, or undone after it was applied.",
            "enum": ["suggested", "approved", "rejected", "retracted"]
          },
          "ProposedChange": {
            "description": "One record a proposal changes: its fields before and after in JSON text, absent where the record does not exist.",
            "type": "object",
            "properties": {"entity": {"type": "string"}, "before": {"type": "string"}, "after": {"type": "string"}},
            "required": ["entity"],
            "additionalProperties": false
          }
        }
      },
      "annotations": {"readOnlyHint": false, "destructiveHint": false}
    },
    {
      "name": "list_my_proposals",
      "title": "List My Proposals",
      "description": "The proposals this agent filed, newest first, a page at a time, with their status. The same as `radar proposal list --actor-kind agent --author <the agent>`.",
      "inputSchema": {
