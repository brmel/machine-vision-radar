#!/usr/bin/env bash
set -eo pipefail

# Git runs hooks from the repo's top level; the commands below run from the code's folder
cd "$(dirname "$0")/.."

bash app/scripts/gates/require.sh node

# Gate nothing twice: a deleted ref carries no code, and a tree that passed here is not run again
needs_gate=0
while read -r _ local_sha remote_ref _; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  bash app/scripts/gates/passed.sh "$local_sha" || needs_gate=1
done
if [[ $needs_gate -eq 0 ]]; then
  echo "=== [pre-push] Nothing to gate: deleted refs, or trees whose gate passed here ==="
  exit 0
fi

if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
  echo "ERROR: Working tree is dirty. Pre-push requires a clean working tree." >&2
  echo "Please commit or stash your unstaged/uncommitted changes before pushing." >&2
  exit 1
fi

echo "=== [pre-push] Running the full local check gate ==="
npm --prefix app run check
