#!/usr/bin/env bash
set -eo pipefail

# Git runs hooks from the repo's top level; the commands below run from the code's folder
cd "$(dirname "$0")/.."
# A linked worktree's hook runs with an absolute GIT_DIR, under which git reads app/ as its own root: rediscover.
unset GIT_DIR

bash app/scripts/gates/require.sh node

# The checks below read the working tree, so it must equal what gets committed.
git diff --quiet \
  || { echo "ERROR: unstaged changes; pre-commit validates the working tree, stage or stash them" >&2; exit 1; }

bash app/scripts/gates/verify.sh

echo "=== [pre-commit] OK ==="
