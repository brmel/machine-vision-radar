{
  "name": "machinevisionradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "arch": "depcruise --config .dependency-cruiser.json \"src/**/*.ts\" \"src/**/*.tsx\"",
    "knip": "knip",
    "duplication": "jscpd",
    "build": "vite build && npm run build:server && npm run prerender && npm run agent-files && node --experimental-strip-types scripts/build-guards.ts",
    "build:server": "vite build --ssr src/shell/root/server.tsx --outDir dist-server --emptyOutDir",
    "studio": "remotion studio studio/index.ts",
    "studio:make": "node --experimental-strip-types studio/render.ts make",
    "studio:still": "node --experimental-strip-types studio/render.ts still",
    "studio:clip": "node --experimental-strip-types studio/render.ts clip",
    "studio:check": "node --experimental-strip-types studio/render.ts check",
    "prerender": "node --experimental-strip-types scripts/prerender/main.ts",
    "agent-files": "cd .. && python3 -m radar site export --out app/dist",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test": "vitest run tests --exclude 'tests/e2e/**'",
    "emulators": "firebase emulators:start --only firestore,storage --project demo-mvradar",
    "check": "bash scripts/gates/check.sh",
    "deploy:local": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/app-check": "0.13.1",
    "@firebase/auth": "1.13.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.64.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@remotion/tailwind-v4": "4.0.535",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.6.0",
    "firebase-tools": "15.32.1",
    "jscpd": "5.4.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "remotion": "4.0.535",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "knip": {
    "entry": ["src/shell/root/server.tsx", "studio/index.ts"],
    "ignore": ["**/generated-views-zod.ts"],
    "playwright": {
      "config": ["playwright.config.ts", "playwright.emulator.config.ts"]
    }
  },
  "jscpd": {
    "path": ["src", "scripts", "../radar"],
    "ignore": ["**/generated-*", "**/domain/views.ts", "**/model/entities.py", "**/tests/fixtures/**", "**/__pycache__/**", "**/*.json"],
    "format": ["typescript", "tsx", "python"],
    "minTokens": 50,
    "threshold": 0,
    "reporters": ["console"],
    "absolute": false,
    "gitignore": true
  }
}
