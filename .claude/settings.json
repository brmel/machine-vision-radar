{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m radar *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)"
    ],
    "deny": [
      "Edit(/dist/**)",
      "Edit(/app/src/adapters/generated-views-zod.ts)",
      "Edit(/app/src/domain/views.ts)",
      "Edit(/radar/domain/model/entities.py)",
      "Edit(/radar/adapters/web/mcp_tools.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
